{
  "$name": "Ember",
  "$version": "0.1.0",
  "$comment": "One source of truth for both layers. Colours are authored in OKLCH so the restoration cross-fade interpolates perceptually instead of drifting through grey. Global tokens are raw values and must never be referenced by a component - the token gate enforces this.",

  "global": {
    "color": {
      "void":      "oklch(13.04% 0.0192 269.8)",
      "void-2":    "oklch(15.25% 0.0243 271.18)",
      "cyan":      "oklch(84.77% 0.1223 215.26)",
      "cyan-deep": "oklch(65.41% 0.1157 223.44)",
      "violet":    "oklch(67.58% 0.187 291.49)",
      "violet-deep":"oklch(49.26% 0.198 286.52)",
      "coral":     "oklch(72.92% 0.1693 34.76)",
      "coral-deep":"oklch(57.78% 0.1627 33.96)",
      "gold":      "oklch(86.55% 0.1274 79.63)",
      "gold-deep": "oklch(69.22% 0.1203 76.49)",
      "mint":      "oklch(81.29% 0.1485 168.35)",
      "mint-deep": "oklch(64.58% 0.1273 167.42)",
      "pink":      "oklch(72.74% 0.1899 356.32)",
      "white":     "oklch(100% 0 0)",
      "paper":     "oklch(97.81% 0.0103 261.79)",
      "ash":       "oklch(88.54% 0.0305 260.71)"
    },
    "space": {
      "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
      "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px",
      "20": "80px", "24": "96px", "32": "128px"
    },
    "blur": { "panel": "8px", "scrim": "18px" },
    "radius": { "sm": "8px", "md": "14px", "lg": "22px", "xl": "34px", "full": "999px" },
    "font": {
      "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "arabic": "'IBM Plex Sans Arabic', 'Amiri', 'Segoe UI', Georgia, serif"
    },
    "size": {
      "xs":   "clamp(11px, 0.68rem + 0.1vw, 12px)",
      "sm":   "clamp(13px, 0.8rem + 0.12vw, 14px)",
      "base": "clamp(15px, 0.92rem + 0.16vw, 17px)",
      "lg":   "clamp(18px, 1.05rem + 0.3vw, 21px)",
      "xl":   "clamp(22px, 1.2rem + 0.6vw, 27px)",
      "2xl":  "clamp(27px, 1.4rem + 1.1vw, 34px)",
      "3xl":  "clamp(33px, 1.6rem + 2vw, 43px)",
      "4xl":  "clamp(41px, 1.8rem + 3.4vw, 66px)"
    },
    "leading": { "tight": "1.08", "snug": "1.28", "body": "1.62", "loose": "1.8" },
    "measure": { "prose": "68ch", "narrow": "46ch" },
    "ease": {
      "spring": "cubic-bezier(.17,.89,.26,1.02)",
      "land":   "cubic-bezier(.2,1.5,.36,1)",
      "exit":   "cubic-bezier(.4,0,1,1)"
    },
    "duration": { "instant": "90ms", "fast": "180ms", "base": "320ms", "slow": "620ms", "cinematic": "1200ms" }
  },

  "semantic": {
    "color": {
      "canvas":          "{global.color.void}",
      "canvas-raised":   "{global.color.void-2}",
      "surface-glass":   "{global.color.white} / 0.055",
      "surface-glass-strong": "{global.color.white} / 0.10",
      "border-subtle":   "{global.color.white} / 0.11",
      "border-strong":   "{global.color.white} / 0.22",
      "text-high":       "{global.color.paper}",
      "text-body":       "{global.color.ash} / 0.74",
      "text-muted":      "{global.color.ash} / 0.44",
      "accent":          "{global.color.cyan}",
      "accent-deep":     "{global.color.cyan-deep}",
      "accent-alt":      "{global.color.violet}",
      "accent-alt-deep": "{global.color.violet-deep}",
      "accent-warm":     "{global.color.coral}",
      "focus-ring":      "{global.color.cyan}",
      "state-success":   "{global.color.mint}",
      "state-warning":   "{global.color.gold}",
      "state-error":     "{global.color.coral}",
      "state-info":      "{global.color.cyan}",
      "memory-restored": "{global.color.gold}",
      "memory-lost":     "{global.color.ash} / 0.44"
    },
    "space": {
      "xs": "{global.space.2}", "sm": "{global.space.3}", "md": "{global.space.4}",
      "lg": "{global.space.6}", "xl": "{global.space.10}", "2xl": "{global.space.16}",
      "section": "{global.space.24}"
    },
    "radius": {
      "control": "{global.radius.sm}", "card": "{global.radius.lg}",
      "panel": "{global.radius.xl}", "pill": "{global.radius.full}"
    },
    "type": {
      "family-ui": "{global.font.sans}", "family-data": "{global.font.mono}", "family-arabic": "{global.font.arabic}",
      "label": "{global.size.xs}", "body": "{global.size.base}", "lede": "{global.size.lg}",
      "title": "{global.size.2xl}", "display": "{global.size.4xl}",
      "leading-body": "{global.leading.body}", "leading-title": "{global.leading.tight}",
      "measure": "{global.measure.prose}"
    },
    "effect": {
      "blur-panel": "{global.blur.panel}",
      "blur-scrim": "{global.blur.scrim}"
    },
    "motion": {
      "ease-enter": "{global.ease.spring}", "ease-land": "{global.ease.land}", "ease-exit": "{global.ease.exit}",
      "hover": "{global.duration.fast}", "reveal": "{global.duration.slow}", "cinematic": "{global.duration.cinematic}"
    }
  },

  "component": {
    "button": {
      "primary-bg": "{semantic.color.accent}",
      "primary-fg": "{global.color.void}",
      "ghost-border": "{semantic.color.border-subtle}",
      "radius": "{semantic.radius.control}",
      "pad-inline": "{semantic.space.lg}",
      "pad-block": "{semantic.space.sm}"
    },
    "memory-card": {
      "bg": "{semantic.color.surface-glass}",
      "border": "{semantic.color.border-subtle}",
      "radius": "{semantic.radius.card}",
      "accent": "{semantic.color.memory-restored}"
    },
    "perf-hud": {
      "bg": "{global.color.void} / 0.82",
      "fg": "{semantic.color.text-body}",
      "good": "{semantic.color.state-success}",
      "warn": "{semantic.color.state-warning}",
      "bad": "{semantic.color.state-error}"
    }
  }
}

{
  "name": "the-forgotten-mind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens && npm run content",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:tokens": "node scripts/gate-tokens.mjs",
    "gate:pagination": "node scripts/gate-pagination.mjs",
    "gates": "npm run gate:tokens && npm run gate:pagination && npx playwright test e2e/react-commits.spec.ts e2e/memory-leak.spec.ts",
    "e2e": "playwright test",
    "verify": "npm run tokens && npm run content && npm run lint && npm run types && npm run test && npm run gate:tokens && npm run gate:pagination",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "assets": "node scripts/optimize-assets.mjs",
    "assets:check": "node scripts/optimize-assets.mjs --check",
    "perf": "node scripts/perf-regression.mjs",
    "content": "node scripts/validate-content.mjs",
    "size": "size-limit"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0-rc.0",
    "@react-three/fiber": "^9.0.0-rc.1",
    "@react-three/rapier": "^2.0.0",
    "detect-gpu": "^5.0.56",
    "gray-matter": "^4.0.3",
    "gsap": "^3.12.5",
    "next": "^15.1.0",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "three": "^0.171.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@next/eslint-plugin-next": "^15.5.25",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^11.2.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "meshoptimizer": "^0.22.0",
    "postcss": "^8.4.49",
    "size-limit": "^11.2.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "name": "Codex JS (GDD Part 12: 20 KB)",
      "path": ".next/static/chunks/app/codex/**/*.js",
      "limit": "20 KB"
    },
    {
      "name": "Title screen JS (part of the 120 KB screen budget)",
      "path": ".next/static/chunks/app/page-*.js",
      "limit": "10 KB"
    },
    {
      "name": "World route shell",
      "path": ".next/static/chunks/app/world/*.js",
      "limit": "15 KB"
    }
  ]
}
